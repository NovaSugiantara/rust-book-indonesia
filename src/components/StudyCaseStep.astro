---
interface Props {
  title: string;
  goal: string;
}

const { title, goal } = Astro.props;
const hasHint = Astro.slots.has('hint');
const hasSolution = Astro.slots.has('solution');
---

<section class="sc-step">
  <h3>{title}</h3>
  <p class="sc-goal"><strong>Tujuan:</strong> {goal}</p>
  <div class="sc-body"><slot /></div>
  {hasHint && (
    <details class="sc-disclosure">
      <summary>Butuh hint?</summary>
      <div class="sc-details"><slot name="hint" /></div>
    </details>
  )}
  {hasSolution && (
    <details class="sc-disclosure">
      <summary>Lihat solusi</summary>
      <div class="sc-details"><slot name="solution" /></div>
    </details>
  )}
</section>

<style>
  .sc-step {
    counter-increment: study-step;
    min-width: 0;
    max-width: 100%;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .sc-step:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .sc-step h3 {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    min-width: 0;
    margin: 0 0 0.4rem;
    font-size: var(--sl-text-lg);
    overflow-wrap: anywhere;
  }

  .sc-step h3::before {
    content: counter(study-step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    align-self: start;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
    font-size: var(--sl-text-xs);
    font-weight: 700;
  }

  .sc-goal {
    min-width: 0;
    margin: 0 0 0.75rem;
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }

  .sc-body,
  .sc-details {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .sc-body > * {
    max-width: 100%;
    min-width: 0;
  }

  .sc-body :where(.expressive-code, figure, pre) {
    max-width: 100%;
    min-width: 0;
  }

  .sc-body pre {
    overflow-x: auto;
  }

  .sc-body :not(pre) > code,
  .sc-goal code,
  .sc-step h3 code,
  .sc-details code {
    overflow-wrap: anywhere;
  }

  .sc-body > :first-child {
    margin-top: 0;
  }

  .sc-body > :last-child {
    margin-bottom: 0;
  }

  .sc-disclosure {
    min-width: 0;
    max-width: 100%;
    margin-top: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    background: var(--sl-color-bg);
  }

  .sc-disclosure summary {
    min-width: 0;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .sc-disclosure summary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    border-radius: 0.35rem;
  }

  .sc-details {
    padding: 0 0.75rem 0.75rem;
    font-size: var(--sl-text-sm);
  }

  .sc-details :where(.expressive-code, figure, pre) {
    max-width: 100%;
    min-width: 0;
  }

  .sc-details > :first-child {
    margin-top: 0;
  }

  .sc-details > :last-child {
    margin-bottom: 0;
  }
</style>
