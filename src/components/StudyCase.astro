---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="study-case" aria-labelledby="study-case-title">
  <header class="sc-header">
    <p class="sc-kicker">Studi kasus</p>
    <h2 id="study-case-title">{title}</h2>
    {intro && <p class="sc-intro">{intro}</p>}
  </header>
  <div class="sc-steps">
    <slot />
  </div>
</section>

<style>
  .study-case {
    max-width: 100%;
    min-width: 0;
    margin: 2rem 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }

  .sc-header {
    min-width: 0;
    margin-bottom: 1.25rem;
  }

  .sc-kicker {
    margin: 0 0 0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }

  .sc-header h2 {
    margin: 0;
    font-size: var(--sl-text-2xl);
    overflow-wrap: anywhere;
  }

  .sc-intro {
    max-width: 100%;
    margin: 0.65rem 0 0;
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }

  .sc-steps {
    counter-reset: study-step;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
  }

  @media (max-width: 40rem) {
    .study-case {
      padding: 0.75rem;
    }
  }
</style>
