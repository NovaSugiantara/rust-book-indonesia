---
const page = Astro.url.pathname;
---

<div class="chapter-completion" data-chapter-completion data-page={page}>
  <div class="cc-copy">
    <p class="cc-title">Sudah selesai dengan halaman ini?</p>
    <p class="cc-note">Progres disimpan di browser ini kalau penyimpanan tersedia.</p>
  </div>
  <button class="cc-button" type="button" data-cc-toggle aria-pressed="false">
    Tandai selesai
  </button>
</div>

<style>
  .chapter-completion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-6);
  }

  .cc-copy {
    min-width: 14rem;
  }

  .cc-title {
    margin: 0;
    font-weight: 600;
  }

  .cc-note {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .cc-button {
    min-height: 2.75rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--sl-color-text-accent);
    border-radius: 0.45rem;
    background: transparent;
    color: var(--sl-color-text-accent);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .cc-button:hover {
    background: var(--sl-color-accent-low);
  }

  .cc-button[aria-pressed='true'] {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
  }

  .cc-button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  @media (max-width: 40rem) {
    .cc-button {
      width: 100%;
    }
  }
</style>

<script>
  import { pageKey, patchPage, readProgress } from '../scripts/progress';

  for (const block of document.querySelectorAll<HTMLElement>('[data-chapter-completion]')) {
    if (block.dataset.ready === 'true') continue;
    block.dataset.ready = 'true';

    const page = pageKey(block.getAttribute('data-page') ?? window.location.pathname);
    const button = block.querySelector<HTMLButtonElement>('[data-cc-toggle]');
    const note = block.querySelector<HTMLElement>('.cc-note');
    if (!button) continue;

    const render = (completed: boolean) => {
      button.setAttribute('aria-pressed', String(completed));
      button.textContent = completed ? 'Sudah selesai' : 'Tandai selesai';
      button.title = completed ? 'Klik untuk membatalkan tanda selesai' : '';
      if (note) {
        note.textContent = completed
          ? 'Halaman ini sudah ditandai selesai.'
          : 'Progres disimpan di browser ini kalau penyimpanan tersedia.';
      }
    };

    render(readProgress()[page]?.completed === true);

    button.addEventListener('click', () => {
      const completed = button.getAttribute('aria-pressed') !== 'true';
      patchPage(page, {
        completed,
        completedAt: completed ? new Date().toISOString() : undefined,
      });
      render(completed);
    });

    window.addEventListener('storage', () => {
      render(readProgress()[page]?.completed === true);
    });
  }
</script>
